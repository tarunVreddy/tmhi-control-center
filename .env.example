# Reference for /data/control-center.env, which the app creates automatically.
# You do not need to copy this file before starting Docker.

# Optional Docker Compose dashboard port on the host.
WEB_PORT=8095

# Gateway local API. Most current T-Mobile gateways use 192.168.12.1:8080.
# Arcadyan TMO-G5AR exposes the same TMI API on plain HTTP port 80; the app
# automatically tries both common same-host variants.
GATEWAY_HOST=192.168.12.1
GATEWAY_PORT=8080
GATEWAY_USERNAME=admin
# The dashboard saves the gateway admin password here after you log in.
GATEWAY_PASSWORD=

# Optional tower map settings. The dashboard can save these in /data/control-center.env.
# OpenCellID needs a free API key from https://www.opencellid.org/ for tower lookups.
MAP_LATITUDE=
MAP_LONGITUDE=
MAP_RADIUS_KM=0.8
PUBLIC_IP_LOCATION_ENABLED=true
OPENCELLID_API_KEY=

# G4AR Unlock / Radio Lab is for owner-controlled gateways only, such as
# secondhand eBay/Amazon units. Firmware override, LTE/NSA radio experiments,
# modem commands, and external antenna mods can brick hardware, void warranty,
# break service terms, or create RF compliance problems.
ADVANCED_MODEM_MODE=disabled
ADVANCED_MODEM_ACKNOWLEDGED=false
ADVANCED_UPLOAD_PROFILE=balanced
ADVANCED_RADIO_PROFILE=auto
ADVANCED_SKIP_STOCK_BACKUP=false
FIRMWARE_BACKUP_DIR=/data/firmware-backups

# Optional speed history. Disabled until enabled from Settings.
# Profiles: gentle 12 MB, standard 30 MB, accurate 125 MB, extended 300 MB,
# and maximum 1 GB. Large profiles use multiple bounded requests.
# Cadences also include every_5_minutes, every_10_minutes, every_15_minutes,
# every_30_minutes, and hourly. Review the dashboard's data-use estimate first.
SPEEDTEST_CADENCE=disabled
SPEEDTEST_PROFILE=gentle
SPEEDTEST_TIMEZONE_OFFSET_MINUTES=0
# Keep speed-test results for 30 to 730 days. The dashboard offers presets.
SPEEDTEST_RETENTION_DAYS=730

# Docker collects radio/signal history even when no dashboard is open.
TELEMETRY_COLLECTION_ENABLED=true
TELEMETRY_SAMPLE_INTERVAL_SECONDS=60

# Keep true for the first deployment. Change to false after testing /api/gateway/test.
DRY_RUN=true
WATCHDOG_ENABLED=true

# Internet must stay failed for this long before a reboot is considered.
CHECK_INTERVAL_SECONDS=20
FAILURE_THRESHOLD_SECONDS=180
STARTUP_GRACE_SECONDS=60

# Prevent reboot loops while the gateway starts and reconnects to cellular service.
POST_REBOOT_GRACE_SECONDS=480
REBOOT_COOLDOWN_SECONDS=1800
MAX_REBOOTS_PER_24H=3

# A round is online when at least this many independent probes pass.
PROBE_TIMEOUT_SECONDS=5
MINIMUM_SUCCESSFUL_PROBES=2
PROBE_URLS=https://connectivitycheck.gstatic.com/generate_204,https://www.cloudflare.com/cdn-cgi/trace,http://www.msftconnecttest.com/connecttest.txt

DATABASE_PATH=/data/control-center.db
LOG_LEVEL=INFO

# Optional comma-separated origins for a separate browser UI.
CORS_ORIGINS=

# The dashboard asks for the gateway admin password before showing anything.
# Only turn this off when nothing untrusted can reach the dashboard port.
DASHBOARD_AUTH_ENABLED=true
